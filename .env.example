# MAEF - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ========================================
# Blockchain Configuration (Mantle Network)
# ========================================

# Mantle Network RPC URL
VITE_MANTLE_NETWORK_URL=https://rpc.mantle.xyz

# Mantle Testnet RPC URL (for development)
# VITE_MANTLE_NETWORK_URL=https://rpc.testnet.mantle.xyz

# Chain ID (5000 for Mainnet, 5001 for Testnet)
VITE_CHAIN_ID=5000

# Block Explorer URL
VITE_EXPLORER_URL=https://explorer.mantle.xyz


# ========================================
# Smart Contract Addresses
# ========================================

# Main NFT Contract Address (deployed on Mantle)
VITE_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Agent Factory Contract Address
VITE_AGENT_FACTORY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000


# ========================================
# IPFS Configuration
# ========================================

# IPFS Gateway URL (for reading metadata)
VITE_IPFS_GATEWAY_URL=https://ipfs.io

# IPFS API URL (for uploading)
VITE_IPFS_API_URL=http://localhost:5001

# Alternative: Pinata IPFS (if using Pinata)
# VITE_PINATA_API_KEY=your_pinata_api_key
# VITE_PINATA_SECRET_KEY=your_pinata_secret_key


# ========================================
# AI Configuration (Spark SDK handles this)
# ========================================

# OpenAI API Key is managed by Spark SDK
# No need to configure here


# ========================================
# Application Settings
# ========================================

# Application Environment
VITE_ENVIRONMENT=development

# Enable Debug Mode
VITE_DEBUG_MODE=true

# Default Gas Limit for transactions
VITE_DEFAULT_GAS_LIMIT=500000

# Gas Price Multiplier (for faster transactions)
VITE_GAS_PRICE_MULTIPLIER=1.2


# ========================================
# Feature Flags
# ========================================

# Enable Blockchain Integration
VITE_ENABLE_BLOCKCHAIN=true

# Enable IPFS Integration
VITE_ENABLE_IPFS=true

# Enable Agent Breeding
VITE_ENABLE_BREEDING=true

# Enable Marketplace
VITE_ENABLE_MARKETPLACE=true


# ========================================
# Analytics & Monitoring (Optional)
# ========================================

# Google Analytics ID
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN (for error tracking)
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx


# ========================================
# Backend API (Optional - for Cloud Run)
# ========================================

# Cloud Run Backend URL
# VITE_BACKEND_API_URL=https://your-app.run.app

# API Authentication Token
# VITE_API_AUTH_TOKEN=your_secure_token


# ========================================
# Development Settings
# ========================================

# Local Development Port
# PORT=5173

# Enable Source Maps in Production
# VITE_SOURCEMAP=false
