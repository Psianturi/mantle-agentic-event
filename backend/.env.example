# MAEF Backend — Local development environment
# Copy to backend/.env for local testing (never commit the real .env)

# ── GCP ─────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=agentic-event-factory

# Set to false for local dev so secrets are read from env vars below
USE_SECRET_MANAGER=false

# ── Secrets (used when USE_SECRET_MANAGER=false) ─────────────────────────────
# The backend minting wallet's private key (holds MINTER_ROLE on contract)
AGENT_PRIVATE_KEY=0x_your_agent_private_key_here

# Preferred operational key for Mode A minting (separate from deployer/admin wallet)
# If set, backend uses this value instead of AGENT_PRIVATE_KEY for fallback/Mode A.
MINTER_SERVICE_PRIVATE_KEY=0x_your_minter_service_private_key_here

# Google Gemini API key — https://aistudio.google.com/app/apikey
LLM_API_KEY=your_gemini_api_key_here

# ── Blockchain ────────────────────────────────────────────────────────────────
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
CHAIN_ID=5003

# Fill in after: cd contracts && npm run deploy:sepolia
CONTRACT_ADDRESS=0x110edEa5DB874589ec4492d15660082634E173f0

# ── Auto Scout (Secretary sub-agent) ─────────────────────────────────────────
# YouTube Data API v3 key — enable at: console.cloud.google.com → APIs → YouTube Data API v3
# Without this, POST /api/v1/agent/{id}/scout returns 503
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# CORS: comma-separated origins allowed to call the backend
# In production (Cloud Run), set this to your GitHub Spark app URL
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
